# Copy to .env (next to docker-compose.yml) and change what you need.
# Values shown are the defaults used when a variable is not set.

# --- CPU limits (number of cores a container may use; fractions allowed) ---
POSTGRES_CPUS=1.0
PRODUCT_CPUS=1.0
INVENTORY_CPUS=1.0
ORDER_CPUS=1.0
MASTERDATA_CPUS=0.5

# --- Memory limits (container is killed if it exceeds this; JVM heap = 75%) ---
POSTGRES_MEMORY=512M
PRODUCT_MEMORY=1G
INVENTORY_MEMORY=1G
ORDER_MEMORY=1G
MASTERDATA_MEMORY=1G

# --- Host ports ---
POSTGRES_PORT=5432
PRODUCT_PORT=8082
INVENTORY_PORT=8083
ORDER_PORT=8081
MASTERDATA_PORT=8084
