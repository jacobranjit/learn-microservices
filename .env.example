# Copy to .env (next to docker-compose.yml) and change what you need.
# Values shown are the defaults used when a variable is not set.

# --- Database credentials (used by postgres AND by product, inventory, order) ---
# CHANGE THE PASSWORD on any server. Avoid $ in the password (Compose treats it as a variable).
# Postgres applies these only when the database is first created (empty volume).
# To change the password of an existing database, without losing data:
#   1. docker exec -it oletrex-postgres psql -U oletrex -d postgres -c "ALTER USER oletrex PASSWORD 'new-password';"
#   2. set POSTGRES_PASSWORD=new-password below
#   3. docker compose up -d     (recreates the services with the new password)
POSTGRES_USER=oletrex
POSTGRES_PASSWORD=oletrex

# --- CPU limits (number of cores a container may use; fractions allowed) ---
POSTGRES_CPUS=1.0
PRODUCT_CPUS=1.0
INVENTORY_CPUS=1.0
ORDER_CPUS=1.0
MASTERDATA_CPUS=0.5
CUSTOMER_CPUS=0.5
AUTH_CPUS=0.5

# --- Memory limits (container is killed if it exceeds this; JVM heap = 75%) ---
POSTGRES_MEMORY=512M
PRODUCT_MEMORY=1G
INVENTORY_MEMORY=1G
ORDER_MEMORY=1G
MASTERDATA_MEMORY=1G
CUSTOMER_MEMORY=768M
AUTH_MEMORY=768M

# --- Host ports ---
POSTGRES_PORT=5432
PRODUCT_PORT=8082
INVENTORY_PORT=8083
ORDER_PORT=8081
MASTERDATA_PORT=8084
CUSTOMER_PORT=8085
AUTH_PORT=8086

# --- Auth ---
# CHANGE ALL OF THESE on any server; the values below are dev defaults.
# First admin, created on startup if no account with this email exists (an existing account is never overwritten).
ADMIN_EMAIL=admin@oletrex.local
ADMIN_PASSWORD=Admin123!
# Secrets the order and inventory services use to get service tokens from POST /api/auth/token.
ORDER_SERVICE_SECRET=order-dev-secret
INVENTORY_SERVICE_SECRET=inventory-dev-secret
# Lifetime of issued access tokens, and the token issuer name every service checks.
JWT_TTL=1h
AUTH_ISSUER=oletrex-auth
# On an existing postgres volume init.sql does not run again; create the new databases by hand:
#   docker exec -it oletrex-postgres psql -U oletrex -d postgres -c "CREATE DATABASE auth_db;" -c "CREATE DATABASE customer_db;"
