# Copy to .env (next to docker-compose.yml) and change what you need.
# Values shown are the defaults used when a variable is not set.
# A fresh clone starts with these dev defaults; the auth service logs a WARN for each secret still at its default.

# ======================================================================================
# Deploying to a server (existing database) -- do these steps in order
# ======================================================================================
#  1. Set ADMIN_EMAIL, ADMIN_PASSWORD, ORDER_SERVICE_SECRET, INVENTORY_SERVICE_SECRET,
#     MASTERDATA_CUSTOMER_PASSWORD and POSTGRES_PASSWORD below in .env BEFORE the first `up`
#     (strong values, no $ character).
#  2. docker compose up -d postgres
#  3. docker exec -it oletrex-postgres psql -U oletrex -d postgres -c "CREATE DATABASE customer_db;" -c "CREATE DATABASE auth_db;"
#     (init.sql runs only on an empty volume, so on an existing database create the new databases by hand)
#  4. docker exec -it oletrex-postgres psql -U oletrex -d order_db -c "DROP TABLE IF EXISTS order_line_items, orders;"
#     (orders now require a customerId and addresses; existing orders are test data without a customer.
#      Hibernate recreates the tables.)
#  5. docker compose up -d --build
#  6. Optional seeding: it creates 300 logins that ALL share MASTERDATA_CUSTOMER_PASSWORD. Do not seed a
#     public server, or set a strong MASTERDATA_CUSTOMER_PASSWORD first.
#
# The admin account is created on the first start and its password is then fixed in the database:
# changing ADMIN_PASSWORD later does nothing unless ADMIN_RESET_PASSWORD=true (see "Auth" below).
#
# Fixing a stuck registration (rare: registration failed AND its automatic clean-up failed too).
# The email stays taken. A half-created account is disabled and has no customer_id; an orphan customer has
# an auth_user_id that matches no account. Find both, then delete them (the databases are separate, so
# compare ids by hand):
#   docker exec -it oletrex-postgres psql -U oletrex -d auth_db -c "SELECT id, email FROM user_accounts WHERE customer_id IS NULL AND role = 'USER';"
#   docker exec -it oletrex-postgres psql -U oletrex -d auth_db -c "DELETE FROM user_accounts WHERE customer_id IS NULL AND role = 'USER';"
#   docker exec -it oletrex-postgres psql -U oletrex -d customer_db -c "SELECT id, email, auth_user_id FROM customers ORDER BY id DESC LIMIT 20;"
#   docker exec -it oletrex-postgres psql -U oletrex -d customer_db -c "DELETE FROM customers WHERE id = <orphan id>;"
# A customer is an orphan when no row in auth_db.user_accounts has its id as id = auth_user_id.
# ======================================================================================

# --- Database credentials (used by postgres AND by product, inventory, order) ---
# CHANGE THE PASSWORD on any server. Avoid $ in the password (Compose treats it as a variable).
# Postgres applies these only when the database is first created (empty volume).
# To change the password of an existing database, without losing data:
#   1. docker exec -it oletrex-postgres psql -U oletrex -d postgres -c "ALTER USER oletrex PASSWORD 'new-password';"
#   2. set POSTGRES_PASSWORD=new-password below
#   3. docker compose up -d     (recreates the services with the new password)
POSTGRES_USER=oletrex
POSTGRES_PASSWORD=oletrex

# --- CPU limits (number of cores a container may use; fractions allowed) ---
POSTGRES_CPUS=1.0
PRODUCT_CPUS=1.0
INVENTORY_CPUS=1.0
ORDER_CPUS=1.0
MASTERDATA_CPUS=0.5
CUSTOMER_CPUS=0.5
AUTH_CPUS=0.5

# --- Memory limits (container is killed if it exceeds this; JVM heap = 75%) ---
POSTGRES_MEMORY=512M
PRODUCT_MEMORY=1G
INVENTORY_MEMORY=1G
ORDER_MEMORY=1G
MASTERDATA_MEMORY=1G
CUSTOMER_MEMORY=768M
AUTH_MEMORY=768M

# --- Host ports ---
POSTGRES_PORT=5432
PRODUCT_PORT=8082
INVENTORY_PORT=8083
ORDER_PORT=8081
MASTERDATA_PORT=8084
CUSTOMER_PORT=8085
AUTH_PORT=8086

# --- Auth ---
# CHANGE ALL OF THESE on any server; the values below are dev defaults.
# First admin, created on startup if no account with this email exists (an existing account is left alone unless ADMIN_RESET_PASSWORD=true).
ADMIN_EMAIL=admin@oletrex.local
ADMIN_PASSWORD=Admin123!
# Password of the 300 seeded customers (customer001@example.com ... customer300@example.com) created by generate-master-data.
MASTERDATA_CUSTOMER_PASSWORD=Customer123!
# Secrets the order and inventory services use to get service tokens from POST /api/auth/token.
ORDER_SERVICE_SECRET=order-dev-secret
INVENTORY_SERVICE_SECRET=inventory-dev-secret
# Set to true for ONE start to give the existing admin account the ADMIN_PASSWORD above again
# (also makes sure it has the ADMIN role and is enabled); then remove it or set it back to false.
ADMIN_RESET_PASSWORD=false
# Lifetime of issued access tokens, and the token issuer name every service checks.
# Must be longer than 1 minute: clients refresh their service token 60 s before it expires.
JWT_TTL=1h
AUTH_ISSUER=oletrex-auth
